# ProxiMan - Environment Configuration Example
# این فایل را کپی کرده و مقادیر واقعی را وارد کنید:
# cp .env.example .env

# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
USE_POLLING=true
WEBHOOK_URL=

# Database
DB_NAME=proxyman
DB_USER=proxyman
DB_PASSWORD=change_this_password

# Redis
REDIS_PASSWORD=change_this_redis_password

# Security
SECRET_KEY=change_this_super_secret_key

# Domain
DOMAIN=your-domain.com

# Logging
LOG_LEVEL=INFO
